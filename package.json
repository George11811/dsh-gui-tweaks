{
  "name": "dsh-gui-tweaks",
  "version": "1.0.0",
  "private": true,
  "description": "One GUI-enhancement bundle: file filtering for @ completion and the files tree, the Browser Bookmarks sidebar tab, conversation delete buttons, and the left/right sidebar swap. Each feature has its own switch on the bundle page.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "scripts": {
    "build": "node tools/build-client.mjs",
    "smoke": "node tools/smoke.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
